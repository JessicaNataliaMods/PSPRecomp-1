-std::wstring mission_line(const SavedataSlotEntry &slot) {
-    if (!slot.savedata_title.empty()) return utf8_to_wide(slot.savedata_title);
-    if (!slot.detail.empty()) return utf8_to_wide(slot.detail);
-    if (!slot.title.empty()) return utf8_to_wide(slot.title);
-    return slot.exists ? L"Saved game" : L"Empty slot";
