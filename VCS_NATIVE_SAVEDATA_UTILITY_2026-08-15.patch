-std::wstring trim_detail(std::wstring value) {
-    for (wchar_t &c : value) {
-        if (c == L'\r' || c == L'\n' || c == L'\t') c = L' ';
-    }
-    while (value.find(L"  ") != std::wstring::npos)
-        value.replace(value.find(L"  "), 2, L" ");
-    if (value.size() > 420u) {
-        value.resize(417u);
-        value += L"...";
-    }
-    return value;
-}
