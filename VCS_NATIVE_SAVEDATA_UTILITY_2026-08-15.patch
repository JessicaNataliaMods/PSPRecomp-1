-void draw_skyline(HDC hdc, const RECT &client) {
-    const int w = client.right - client.left;
-    const int h = client.bottom - client.top;
-    const int horizon = client.top + h * 70 / 100;
-
-    HBRUSH brush = CreateSolidBrush(kSkyline);
-    HPEN pen = CreatePen(PS_SOLID, 1, kSkyline);
-    HBRUSH old_brush = static_cast<HBRUSH>(SelectObject(hdc, brush));
-    HPEN old_pen = static_cast<HPEN>(SelectObject(hdc, pen));
-
-    auto building = [&](int pct_x, int pct_w, int pct_h) {
-        const int x = client.left + w * pct_x / 100;
-        const int bw = w * pct_w / 100;
-        const int bh = h * pct_h / 100;
-        Rectangle(hdc, x, horizon - bh, x + bw, horizon + 1);
-    };
-    building(0, 8, 7); building(9, 7, 9); building(18, 12, 6);
-    building(32, 7, 11); building(42, 13, 8); building(58, 8, 6);
-    building(69, 10, 10); building(81, 7, 15); building(89, 11, 9);
-
-    auto palm = [&](int pct_x, int pct_h, int lean) {
-        const int x = client.left + w * pct_x / 100;
-        const int ph = h * pct_h / 100;
-        const int top_x = x + lean;
-        const int top_y = horizon - ph;
-        MoveToEx(hdc, x, horizon, nullptr); LineTo(hdc, top_x, top_y);
-        MoveToEx(hdc, top_x, top_y, nullptr); LineTo(hdc, top_x - 28, top_y - 9);
-        MoveToEx(hdc, top_x, top_y, nullptr); LineTo(hdc, top_x + 31, top_y - 7);
-        MoveToEx(hdc, top_x, top_y, nullptr); LineTo(hdc, top_x - 24, top_y + 8);
-        MoveToEx(hdc, top_x, top_y, nullptr); LineTo(hdc, top_x + 25, top_y + 9);
-    };
-    palm(10, 12, -10); palm(22, 15, 8); palm(48, 11, -7); palm(73, 14, 9);
-
-    SelectObject(hdc, old_pen);
-    SelectObject(hdc, old_brush);
-    DeleteObject(pen);
-    DeleteObject(brush);
-
-    HBRUSH water = CreateSolidBrush(RGB(87, 148, 205));
-    RECT lower{client.left, horizon, client.right, client.bottom};
-    FillRect(hdc, &lower, water);
-    DeleteObject(water);
-    for (int y = horizon + 4; y < client.bottom; y += 5) {
-        HBRUSH line = CreateSolidBrush((y / 5) % 2 == 0 ? RGB(100, 161, 215)
-                                                          : RGB(81, 139, 197));
-        RECT band{client.left, y, client.right, y + 2};
-        FillRect(hdc, &band, line);
-        DeleteObject(line);
-    }
-}
