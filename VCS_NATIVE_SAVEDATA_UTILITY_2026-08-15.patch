-void draw_list_item(const DRAWITEMSTRUCT &dis, const DialogState &state) {
-    if (dis.itemID == static_cast<UINT>(-1) || !state.slots ||
-        dis.itemID >= state.slots->size()) return;
-    const auto &slot = (*state.slots)[dis.itemID];
-    const bool selected = (dis.itemState & ODS_SELECTED) != 0;
-    COLORREF bg = slot.exists ? kListFill : RGB(245, 247, 251);
-    COLORREF fg = slot.exists ? kListSavedText : kListEmptyText;
-    COLORREF sub = slot.exists ? RGB(74, 91, 121) : RGB(133, 141, 158);
-    if (selected) { bg = kSelection; fg = kText; sub = RGB(220, 242, 255); }
-
-    HBRUSH brush = CreateSolidBrush(bg);
-    FillRect(dis.hDC, &dis.rcItem, brush);
-    DeleteObject(brush);
-    SetBkMode(dis.hDC, TRANSPARENT);
-
-    RECT primary = dis.rcItem;
-    primary.left += 12;
-    primary.top += 5;
-    primary.bottom = primary.top + 24;
-    SelectObject(dis.hDC, state.list_font);
-    SetTextColor(dis.hDC, fg);
-    std::wstring name = L"SLOT " + std::to_wstring(dis.itemID + 1u);
-    name += slot.exists ? L"   SAVED" : L"   EMPTY";
-    DrawTextW(dis.hDC, name.c_str(), -1, &primary, DT_LEFT | DT_VCENTER | DT_SINGLELINE);
-
-    RECT secondary = dis.rcItem;
-    secondary.left += 12;
-    secondary.top += 29;
-    secondary.right -= 12;
-    secondary.bottom -= 4;
