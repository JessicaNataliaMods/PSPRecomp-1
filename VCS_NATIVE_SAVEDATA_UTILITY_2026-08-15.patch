-RECT panel_rect(HWND window) {
-    RECT c{};
-    GetClientRect(window, &c);
-    const int w = c.right - c.left;
-    const int h = c.bottom - c.top;
-    const int pw = w * 76 / 100;
-    const int ph = h * 72 / 100;
-    const int left = (w - pw) / 2;
-    const int top = (h - ph) / 2;
-    return RECT{left, top, left + pw, top + ph};
-}
