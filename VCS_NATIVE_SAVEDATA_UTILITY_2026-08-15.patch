-void layout_controls(HWND window, DialogState &state) {
-    if (!state.list) return;
-    const RECT p = panel_rect(window);
-    const int margin = scale_px(window, 26);
-    const int title_h = scale_px(window, 82);
-    const int buttons_h = scale_px(window, 44);
-    const int gap = scale_px(window, 18);
-    const int content_top = p.top + title_h;
-    const int content_bottom = p.bottom - buttons_h - margin;
-    const int content_w = p.right - p.left - margin * 2;
-    const int list_w = content_w * 58 / 100;
-
-    MoveWindow(state.list,
-               p.left + margin, content_top,
-               list_w, content_bottom - content_top,
-               TRUE);
-
-    const int button_w = scale_px(window, 112);
-    const int button_gap = scale_px(window, 12);
-    const int buttons_y = p.bottom - buttons_h - scale_px(window, 12);
-    MoveWindow(state.cancel_button,
-               p.right - margin - button_w, buttons_y,
-               button_w, buttons_h, TRUE);
-    MoveWindow(state.accept_button,
-               p.right - margin - button_w * 2 - button_gap, buttons_y,
-               button_w, buttons_h, TRUE);
