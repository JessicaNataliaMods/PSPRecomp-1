+        }
+        return;
+    }
+
+    if (savedata_utility.prompt == SavedataUtilityUiPrompt::Result) {
+        if ((pressed & (kPspUtilityCircle | kPspUtilityStart)) != 0u) {
+            if (savedata_utility.last_result != 0u) {
+                // PSP LIST operations return to the list after an I/O failure
