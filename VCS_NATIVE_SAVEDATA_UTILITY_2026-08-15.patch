-void fill_horizontal_gradient(HDC hdc, const RECT &rect, COLORREF left, COLORREF right) {
-    const int width = rect.right - rect.left;
-    const int safe_width = width > 1 ? width : 1;
-    constexpr int kBands = 256;
-    for (int i = 0; i < kBands; ++i) {
-        const int x0 = rect.left + safe_width * i / kBands;
-        const int x1 = rect.left + safe_width * (i + 1) / kBands;
-        const float t = static_cast<float>(i) / static_cast<float>(kBands - 1);
-        HBRUSH brush = CreateSolidBrush(lerp_color(left, right, t));
-        RECT band{x0, rect.top, x1 + 1, rect.bottom};
-        FillRect(hdc, &band, brush);
-        DeleteObject(brush);
-    }
-}
